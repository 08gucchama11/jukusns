<!DOCTYPE html>
<html>
  <head>
    <title>塾SNS SNSページ</title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    >

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-success-subtle">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <%= link_to "塾SNS", sns_root_path, class: "navbar-brand" %>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#adminNavbar"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="adminNavbar">
          <%# 生徒または講師がログインしている時だけ、ナビを表示する %>
          <% if Current.student.present? || Current.teacher.present? %>
            <ul class="navbar-nav ms-auto align-items-lg-center">
              <li class="nav-item">
                <%# ログイン中のロールによって、戻るダッシュボードを出し分ける %>
                <% if Current.student.present? %>
                  <%= link_to "ダッシュボード", dashboard_path, class: "nav-link" %>
                <% elsif Current.teacher.present? %>
                  <%= link_to "ダッシュボード", teachers_dashboard_path, class: "nav-link" %>
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to "タイムライン", sns_root_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "マイページ", sns_my_page_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "いいね一覧", sns_likes_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "フォロー一覧", sns_follows_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%# ログイン中のロールに合ったセッションを削除してログアウトする %>
                <% if Current.student.present? %>
                  <%= button_to "ログアウト", session_path, method: :delete, class: "btn btn-outline-light btn-sm ms-lg-2 mt-2 mt-lg-0" %>
                <% elsif Current.teacher.present? %>
                  <%= button_to "ログアウト", teachers_session_path, method: :delete, class: "btn btn-outline-light btn-sm ms-lg-2 mt-2 mt-lg-0" %>
                <% end %>
              </li>
            </ul>
          <% end %>
        </div>
      </div>
    </nav>
    <%# SNSのどの画面からでも使える検索フォーム %>
    <div class="border-bottom">
      <div class="container py-3">
        <%= form_with url: sns_search_path, method: :get, class: "row g-2", data: { turbo: false } do |f| %>
          <div class="col-12 col-sm-3">
          <%# 検索する対象を選ぶ。「投稿本文」か「ニックネーム」か %>
            <%= f.select :target, [["投稿本文", "posts"], ["ニックネーム", "profiles"]], { selected: params[:target] }, class: "form-select" %>
          </div>
          <div class="col-12 col-sm">
            <%# 入力した文字は q という名前で検索画面へ送られる %>
            <%= f.text_field :q, value: params[:q], class: "form-control", placeholder: "検索したい文字を入力" %> </div>
          <div class="col-12 col-sm-auto">
            <%= f.submit "検索", class: "btn btn-primary w-100" %>
          </div>
        <% end %>
      </div>
    </div>
  <main class="py-4">
    <div class="container">
      <% if flash[:alert] %>
        <div class="alert alert-danger">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <% if flash[:notice] %>
        <div class="alert alert-success">
          <%= flash[:notice] %>
        </div>
      <% end %>
    </div>
  <%= yield %>
</main>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
<!DOCTYPE html>
<html>
  <head>
    <title>塾SNS</title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    >

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-danger-subtle">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <%= link_to "塾SNS", dashboard_path, class: "navbar-brand" %>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#adminNavbar"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="adminNavbar">
          <% if authenticated? %>
            <ul class="navbar-nav ms-auto">
              <li class="nav-item">
                <%= link_to "ダッシュボード", dashboard_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "お知らせ", announcements_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "指導記録", instruction_records_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "SNSタイムライン", sns_root_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= button_to "ログアウト", session_path, method: :delete, class: "btn btn-outline-light ms-lg-2" %>
              </li>
            </ul>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="container py-4">
      <% if flash[:alert] %>
        <div class="alert alert-danger">
          <%= flash[:alert] %>
        </div>
      <% end %>
      <% if flash[:notice] %>
        <div class="alert alert-success">
          <%= flash[:notice] %>
        </div>
      <% end %>
      <%= yield %>
    </main>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
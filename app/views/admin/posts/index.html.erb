<div class="container">
  <div class="row justify-content-center mt-3 mb-3">
    <div class="col-xl-10">
      <h1>SNS投稿一覧</h1>
    </div>
  </div>
  <div class="row justify-content-center">
    <div class="col-xl-10">
      <table class="table table-striped table-hover align-middle">
        <thead>
          <tr>
            <th style="width: 20%">日時</th>
            <th style="width: 15%">ニックネーム</th>
            <th style="width: 50%">投稿内容</th>
            <th></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @posts.each do |post| %>
            <tr>
              <td><%= post.created_at.strftime("%Y年%m月%d日 %H:%M") %></td>
              <td><%= post.sns_profile.nickname %></td>
              <td><%= post.body %></td>
              <td></td>
              <td><%= button_to "削除", admin_post_path(post), method: :delete, class: "btn btn-danger btn-sm", form: { data: { turbo: true, turbo_confirm: "この投稿を削除しますか？" } } %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
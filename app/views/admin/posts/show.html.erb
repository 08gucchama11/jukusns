<div class="container">
  <div class="row justify-content-center mt-3 mb-3">
    <div class="col-xl-10">
      <h1>SNS投稿詳細</h1>
      <%= link_to "一覧へ戻る", admin_posts_path, class: "btn btn-success btn-sm" %>
    </div>
  </div>
  <div class="row justify-content-center mt-3 mb-3">
    <div class="col-12 col-xl-10">
      <h3>投稿</h3>
        <div class="card my-3 shadow-sm">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span><%= @post.sns_profile.nickname %></span>
            <small class="text-body-secondary">
              <%= @post.created_at.strftime("%Y年%m月%d日 %H:%M") %>
            </small>
          </div>
          <div class="card-body">
            <%= simple_format(@post.body, { class: "card-text mb-0" }) %>
          </div>
        </div>
    </div>
  </div>
  <div class="row justify-content-center mt-3 mb-3">
    <div class="col-xl-10">
      <h3><%= @post.comments.size %>件のコメント</h3>
      <% @post.comments.each do |comment| %>
        <div class="card my-3 shadow-sm">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span><%= comment.sns_profile.nickname %></span>
              <small class="text-body-secondary">
                <%= comment.created_at.strftime("%Y年%m月%d日 %H:%M") %>
              </small>
          </div>
          <div class="card-body">
            <%= simple_format(comment.body, { class: "card-text mb-0" }) %>
          </div>
          <div class="card-footer bg-white border-top-0">
            <%= button_to "削除", admin_comment_path(comment), method: :delete, class: "btn btn-danger btn-sm", form: { data: { turbo_confirm: "このコメントを削除しますか？" } } %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
<%= tag.div(flash[:alert], style: "color: red") if flash[:alert] %>
<%= tag.div(flash[:notice], style: "color: green") if flash[:notice] %>

<%= form_with url: admin_login_path do |form| %>
  <div>
    <%= form.label :code, "管理者コード" %>
    <%= form.text_field :code, required: true, autofocus: true, autocomplete: "username", value: params[:code] %>
  </div>

  <div>
    <%= form.label :password, "パスワード" %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
  </div>

  <%= form.submit "ログイン" %>
<% end %>
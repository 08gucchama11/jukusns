
<% subject_labels = {
  1 => "国語", 2 => "数学", 3 => "英語",
  4 => "理科", 5 => "社会", 6 => "その他"
} %>

<div class="container">
  <div class="row justify-content-center mt-3 mb-3">
    <div class="col-xl-10">
      <h1>指導記録一覧</h1>
      <% if @teacher.present? %>
        <%= link_to "講師詳細へ戻る", admin_teacher_path(@teacher), class: "btn btn-success btn-sm" %>
      <% end %>
      <% if @student.present? %>
        <%= link_to "生徒詳細へ戻る", admin_student_path(@student), class: "btn btn-success btn-sm" %>
      <% end %>
    </div>
  </div>
  <div class="row justify-content-center">
    <div class="col-xl-10">
      <table class="table table-striped table-hover align-middle">
        <thead>
          <tr>
            <th style="width: 15%">日付</th>
            <th style="width: 15%">生徒氏名</th>
            <th style="width: 15%">講師氏名</th>
            <th style="width: 10%">教科</th>
            <th style="width: 15%">単元</th>
            <th style="width: 30%">指導内容</th>
          </tr>
        </thead>
        <tbody>
          <% @instruction_records.each do |instruction_record| %>
            <tr>
              <td><%= instruction_record.created_at.strftime("%Y年%m月%d日") %></td>
              <td><%= instruction_record.student.name %></td>
              <td><%= instruction_record.teacher.name %></td>
              <td><%= subject_labels[instruction_record.subject] %></td>
              <td><%= instruction_record.unit %></td>
              <td><%= simple_format(instruction_record.instruction_record, { class: "mb-0" }) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<div class="container">
  <div class="row justify-content-center my-3">
    <div class="col-12 col-md-6">
      <h2>お知らせ入力フォーム</h2>
        <% if @announcement.errors.any? %>
          <div class="alert alert-danger">
            <p><%= @announcement.errors.count %>件のエラーが発生しました</p>
            <ul class="mb-0">
              <% @announcement.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
      <%= form_with model: [:admin, @announcement] do |f| %>
        <div class="field">
          <%= f.label :title, "タイトル" %><br>
          <%= f.text_field :title, class: "form-control" %>
        </div>
        <div class="field">
          <%= f.label :body, "お知らせ本文" %><br>
          <%= f.text_area :body, class: "form-control mb-3" %>
        </div>
        <div class="action">
          <%= f.submit "新規登録", class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>
    </div>
  </div>
  <div class="row justify-content-center my-5">
    <div class="col-12 col-xl-10 px-3 px-lg-5">
      <h2>お知らせ一覧</h2>
      <table class="table table-striped table-hover align-middle">
        <thead>
          <tr>
            <th style="width: 15%" >投稿日時</th>
            <th style="width: 25%">タイトル</th>
            <th style="width: 60%">本文</th>
          </tr>
        </thead>
        <tbody>
          <% @announcements.each do |announcement| %>
            <tr>
              <td><%= announcement.created_at.strftime("%Y年%m月%d日") %></td>
              <td><%= announcement.title %></td>
              <td><%= announcement.body %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
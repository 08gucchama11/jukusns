<div class="conteiner">
  <div class="row justify-content-center mt-3">
    <div class="col-xl-10">
      <h1>講師詳細</h1>
      <%= link_to "編集", edit_admin_teacher_path(@teacher), class: "btn btn-primary" %>
      <%= link_to "講師一覧へ戻る", admin_teachers_path, class: "btn btn-success" %>
    </div>
  </div>
  <div class="row justify-content-center">
    <div class="col-xl-10">
      <div class="card shadow my-3">
        <div class="card-body">
          <table class="table table-borderless">
            <tr>
              <td style="width: 15%">氏名：</td>
              <td style="width: 85%"><%= @teacher.name %></td>
            </tr>
            <tr>
              <td>講師コード：</td>
              <td><%= @teacher.code %></td>
            </tr>
            <tr>
              <td>電話番号：</td>
              <td><%= @teacher.telephone_number %></td>
            </tr>
            <tr>
              <td>在籍ステータス：</td>
              <td><%= @teacher.is_active ? "在籍中" : "退職済み" %></td>
            </tr>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
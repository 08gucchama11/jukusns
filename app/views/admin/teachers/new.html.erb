<div class="container">
  <div class="row justify-content-center mt-3">
    <div class="col-xl-10">
      <h1>講師情報登録</h1>
    </div>
  </div>
  <div class="row justify-content-center mt-3">
    <% if @teacher.errors.any? %>
      <div class="col-xl-10">
        <div class="alert alert-danger">
          <p><%= @teacher.errors.count %>件のエラーが発生しました</p>
          <ul class="mb-0">
            <% @teacher.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>
  </div>
  <div class="row justify-content-center">
    <div class="col-xl-10">
      <%= link_to "講師一覧へ戻る", admin_teachers_path, class: "btn btn-success" %>
    </div>
  </div>
  <div class="row justify-content-center mt-3">
    <div class="col-xl-10">
      <%= form_with model: [:admin, @teacher] do |f| %>

        <div class="field mb-3">
          <%= f.label :name, "氏名" %><br>
          <%= f.text_field :name, autofocus: true, class: "form-control w-25" %>
        </div>

        <div class="field mb-3">
          <%= f.label :code, "講師コード" %><br>
          <%= f.text_field :code, class: "form-control w-25" %>
        </div>

        <div class="field mb-3">
          <%= f.label :password, "パスワード" %><br>
          <%= f.text_field :password, class: "form-control w-25" %>
        </div>

        <div class="field mb-3">
          <%= f.label :telephone_number, "電話番号" %><br>
          <%= f.text_field :telephone_number, class: "form-control w-25" %>
        </div>

        <div class="field mb-3">
          <%= f.radio_button :is_active, true %>
          <%= f.label :is_active_true, "在職中" %>

          <%= f.radio_button :is_active, false %>
          <%= f.label :is_active_false, "退職済み" %>
        </div>

        <div class="action mt-3">
          <%= f.submit "登録", class: "btn btn-primary" %>
        </div>

      <% end %>
    </div>
  </div>
</div>
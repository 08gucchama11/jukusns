<div class="container">
  <div class="row justify-content-center mt-3 mb-3">
    <div class="col-xl-10">
      <h1>生徒一覧</h1>
    </div>
  </div>
  <div class="row justify-content-center">
    <div class="col-xl-10">
      <table class="table table-striped table-hover align-middle">
        <thead>
          <tr>
            <th style="width: 25%" >生徒コード</th>
            <th style="width: 60%">氏名</th>
            <th style="width: 15%"></th>
          </tr>
        </thead>
        <tbody>
          <% @students.each do |student| %>
            <tr>
              <td><%= student.code %></td>
              <td><%= student.name %></td>
              <td><%= link_to "詳細", teachers_student_path(student), class: "btn btn-primary" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
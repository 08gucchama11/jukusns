<div class="container">
  <div class="row justify-content-center mt-3 mb-3">
    <div class="col-xl-10">
      <h1><%= @sns_profile.nickname %>さんのマイページ</h1>
      <div class="card my-3" >
        <div class="card-body">
          <h5>自己紹介</h5>
          <% if @sns_profile.introduction.present? %>
            <%= simple_format(@sns_profile.introduction, { class: "mb-0" }) %>
          <% else %>
            <p class="text-body-secondary mb-0">まだ自己紹介はありません。</p>
          <% end %>
        </div>
        <div class="card-footer bg-white border-top-0">
          <%= link_to "プロフィール編集", edit_sns_profile_path(@sns_profile), class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    </div>
  </div>
  <div class="row justify-content-center my-5">
    <div class="col-12 col-xl-10 px-3 px-lg-5">
      <h3>投稿一覧</h3>
        <% if @posts.any? %>
          <% @posts.each do |post| %>
            <div class="card my-4 shadow">
              <div class="card-header d-flex justify-content-between align-items-center">
                <span><%= post.sns_profile.nickname %></span>
                <small class="text-body-secondary"><%= post.created_at.strftime("%Y年%m月%d日 %H:%M") %></small>
              </div>
              <div class="card-body">
                <%= simple_format(post.body, { class: "card-text mb-0" }) %>
              </div>
              <div class="card-footer bg-white border-top-0 d-flex align-items-center gap-2">
                <% liked = post.likes.any? { |like| like.sns_profile_id == current_sns_profile.id } %>

                <% if liked %>
                  <%# いいね済みなら、DELETEでいいねを解除する %>
                  <%= button_to "♥ #{post.likes.size}", sns_post_like_path(post), method: :delete, class: "btn btn-primary btn-sm" %>
                <% else %>
                  <%# 未いいねなら、POSTで新しくいいねを作る %>
                  <%= button_to "♡ #{post.likes.size}", sns_post_like_path(post), method: :post, class: "btn btn-outline-primary btn-sm" %>
                <% end %>
                <%= link_to "#{post.comments.size}コメント", sns_post_path(post), class: "btn btn-primary btn-sm" %>
                <%= button_to "削除", sns_post_path(post, from: "my_page"), method: :delete, class: "btn btn-danger btn-sm", form: { data: { turbo_confirm: "この投稿を削除しますか？" } } %>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="text-body-secondary my-4">まだ投稿はありません。</p>
        <% end %>
    </div>
  </div>
</div>
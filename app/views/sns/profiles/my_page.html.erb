<div class="container">
  <div class="row justify-content-center mt-3 mb-3">
    <div class="col-xl-10">
      <h1><%= @sns_profile.nickname %>さんのマイページ</h1>
        <div class="card my-3" >
          <div class="card-body">
            <h5>自己紹介</h5>
            <p><%= simple_format(@sns_profile.introduction) %></p>
          </div>
        </div>
      <%= link_to "プロフィール編集", edit_sns_profile_path(@sns_profile), class: "btn btn-primary btn-sm" %>
      <%= link_to "タイムライン", sns_root_path, class: "btn btn-success btn-sm" %>
    </div>
  </div>
  <div class="row justify-content-center my-5">
    <div class="col-12 col-xl-10 px-3 px-lg-5">
        <h3>投稿一覧</h3>
        <% @posts.each do |post| %>
          <div class="card my-4 shadow">
            <div class="card-header d-flex justify-content-between align-items-center">
              <span><%= post.sns_profile.nickname %></span>
              <small class="text-body-secondary">
                <%= post.created_at.strftime("%Y年%m月%d日 %H:%M") %>
              </small>
            </div>
            <div class="card-body">
              <p class="card-text mb-0"><%= post.body %></p>
            </div>
            <div class="card-footer">
              <%= button_to "削除", sns_post_path(post, from: "my_page"), method: :delete, class: "btn btn-danger btn-sm", form: { data: { turbo: true, turbo_confirm: "この投稿を削除しますか？" } } %>
            </div>
          </div>
        <% end %>
    </div>
  </div>
</div>
<div class="container">
  <div class="row justify-content-center mt-3 mb-3">
    <div class="col-xl-10">
      <h1>タイムライン</h1>
      <%= link_to "マイページ", sns_my_page_path, class: "btn btn-primary btn-sm" %>
    </div>
  </div>
  <div class="row justify-content-center my-5">
    <div class="col-12 col-xl-10 px-3 px-lg-5">
      <h3>投稿フォーム</h3>
        <% if @post.errors.any? %>
          <div class="alert alert-danger">
            <p><%= @post.errors.count %>件のエラーが発生しました</p>
            <ul class="mb-0">
              <% @post.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
      <%= form_with model: [:sns, @post] do |f| %>
        <div class="field">
          <%= f.label :body, "投稿" %><br>
          <%= f.text_area :body, class: "form-control mb-3", maxlength: 140 %>
        </div>
        <div class="action">
          <%= f.submit "投稿する", class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>
    </div>
  </div>
  <div class="row justify-content-center my-5">
    <div class="col-12 col-xl-10 px-3 px-lg-5">
      <h3>投稿一覧</h3>
      <% @posts.each do |post| %>
        <div class="card my-4 shadow">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span><%= post.sns_profile.nickname %></span>
            <small class="text-body-secondary">
              <%= post.created_at.strftime("%Y年%m月%d日 %H:%M") %>
            </small>
          </div>
          <div class="card-body">
            <%= simple_format(post.body, { class: "card-text mb-0" }) %>
          </div>
          <div class="card-footer bg-white border-top-0 d-flex align-items-center gap-2">
            <%= link_to "#{post.comments.size}コメント", sns_post_path(post), class: "btn btn-primary btn-sm" %>
            <% if post.sns_profile == current_sns_profile %>
              <%= button_to "削除", sns_post_path(post), method: :delete, class: "btn btn-danger btn-sm", form: { data: { turbo: true, turbo_confirm: "この投稿を削除しますか？" } } %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
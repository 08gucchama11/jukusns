<div class="container">
  <div class="row justify-content-center my-3">
    <div class="col-12 col-md-6">
      <h2>SNS投稿フォーム</h2>
        <% if @post.errors.any? %>
          <div class="alert alert-danger">
            <p><%= @post.errors.count %>件のエラーが発生しました</p>
            <ul class="mb-0">
              <% @post.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
      <%= form_with model: [:sns, @post] do |f| %>
        <div class="field">
          <%= f.label :body, "投稿" %><br>
          <%= f.text_area :body, class: "form-control mb-3" %>
        </div>
        <div class="action">
          <%= f.submit "投稿する", class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>
    </div>
  </div>
  <div class="row justify-content-center my-5">
    <div class="col-12 col-xl-10 px-3 px-lg-5">
      <h2>投稿一覧</h2>
      <table class="table table-striped table-hover align-middle">
        <thead>
          <tr>
            <th style="width: 15%" >投稿日時</th>
            <th style="width: 25%">ニックネーム</th>
            <th style="width: 60%">本文</th>
          </tr>
        </thead>
        <tbody>
          <% @posts.each do |post| %>
            <tr>
              <td><%= post.created_at.strftime("%Y年%m月%d日") %></td>
              <td><%= post.sns_profile.nickname %></td>
              <td><%= post.body %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>